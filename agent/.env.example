# Copy to .env (or set these as env vars in run.bat / the scheduled task) and fill in.

# Base URL of the Heroku app (no trailing slash).
SERVER_URL=https://your-app-name.herokuapp.com

# Shared secret. The agent runs as SITE=all (one agent pings every location), which
# uses the MASTER AGENT_TOKEN — this must exactly match the AGENT_TOKEN config var on
# Heroku.
AGENT_TOKEN=change-me-to-a-long-random-string

# One agent covers every location; the server maps each device's report to its
# location by IP. Leave this as "all".
SITE=all

# Friendly name for THIS agent (e.g. windows-server). Recorded on the outages/
# recoveries it reports so you can tell which agent saw what. Defaults to the
# machine's hostname if unset.
# AGENT_NAME=windows-server

# Seconds between full ping sweeps of every device. Devices are pinged concurrently,
# so the sweep finishes in ~one ping timeout regardless of fleet size.
POLL_INTERVAL=60

# Seconds between polls of the server (also how fast a "Check Now" is picked up).
FLAG_POLL_INTERVAL=20

# Max concurrent pings per sweep (thread pool). Higher = faster sweeps, more CPU.
# PING_WORKERS=40

# Optional log file (recommended on Windows). Set it to write a SIZE-CAPPED, auto-
# rotating log — it can't grow forever: at LOG_MAX_MB it rolls over and keeps only
# LOG_BACKUPS old files (defaults: 5 MB x 3 = ~20 MB max on disk). If you set this,
# do NOT also redirect output to the same file (e.g. `>> agent.log`) — that would
# write it twice.
# LOG_FILE=C:\ap-monitor-agent\agent.log
# LOG_MAX_MB=5
# LOG_BACKUPS=3
